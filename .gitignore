# =============================================================================
# ExaVaR .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Environment / secrets ---
.env
.env.*
*.env

# --- Logs ---
*.log
logs/

# --- Data files (large CSVs — source externally, see data/README.md) ---
data/*.csv
data/price_bars_cleaned.csv

# --- Pytest / test artifacts ---
.pytest_cache/
.coverage
htmlcov/
*.xml

# --- Build / distribution ---
dist/
build/
*.egg-info/
*.egg

# --- OS artifacts ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.idea/
.vscode/
*.suo
*.user

# --- Screenshots / generated docs (keep docs/screenshot.png tracked) ---
docs/*_full.png
docs/*_test.png
